{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "Rainveil-mod",
  "description": "Shows CraftEngine's custom items/blocks as their true identity in JEI and Jade, and adds AllMusic's in-game music playback and HUD.",
  "environment": "client",
  "entrypoints": {
    "main": [
      "com.coloryr.allmusic.comm.AllMusicInit"
    ],
    "client": [
      "com.ceclientmod.CraftEngineClientModInit",
      "com.coloryr.allmusic.client.AllMusicClient"
    ],
    "jade": [
      "com.ceclientmod.jade.CeJadePlugin"
    ],
    "jei_mod_plugin": [
      "com.ceclientmod.jei.CeJeiPlugin"
    ]
  },
  "mixins": [
    {
      "config": "allmusic_client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_dependency}",
    "java": ">=${java_version}"
  },
  "suggests": {
    "jei": "*",
    "jade": "*",
    "modernui": "*"
  }
}
